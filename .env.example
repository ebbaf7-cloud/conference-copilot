# Optional, server-side only. Never expose this value through a NEXT_PUBLIC_* variable or commit a real key.
# Enables evidence-led reranking, the automatic challenge pass, outreach, and model-generated meeting prep.
# Without it, or if a model call fails, Conference Copilot uses its deterministic local fallbacks.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5. Use an OpenAI model that supports the Responses API and Structured Outputs.
# If the configured model is unavailable or incompatible, the app falls back locally.
OPENAI_MODEL=gpt-5
